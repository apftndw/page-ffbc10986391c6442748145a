nt-weight: bold}\n.table-wrap {overflow-x: auto}\ntable.comparison {width: 100%;border-collapse: collapse;background: #ffffff;border: 2px solid var(--border)}\ntable.comparison th, table.comparison td {padding: 1rem;text-align: left;border: 1px solid var(--border)}\ntable.comparison th {background-color: var(--text);color: #ffffff}\ntable.comparison tr:nth-child(even) {background-color: var(--panel)}\n.faq-grid {display: grid;grid-template-columns: 1fr 1fr;gap: 2rem}\n@media (max-width: 768px) {\n  .faq-grid {grid-template-columns: 1fr}\n}\n.faq-item {border: 2px dashed var(--border);padding: 1.5rem;background: #ffffff}\n.faq-item h3 {font-size: 1.1rem;margin-bottom: 0.5rem;color: var(--text)}\n.faq-item p {color: var(--muted);font-size: 0.95rem}\n.steps-list {display: flex;flex-direction: column;gap: 1.5rem}\n.step-item {display: flex;gap: 1.5rem;align-items: flex-start;background: #ffffff;border: 2px dashed var(--border);padding: 1.5rem}\n.step-num {font-size: 2rem;font-weight: 900;color: var(--accent);line-height: 1}\nfooter {background-color: var(--text);color: #ffffff;padding: 3rem 2rem;text-align: center}\nfooter p {color: #aaaaaa;font-size: 0.9rem}\n</style><main>\n  <div class=\"hero-band\">\n    <div class=\"container\">\n      <h1>skkm33</h1>\n      <p>面向专业场景的网络连接管理与传输服务。提供清晰、务实的流量配置方案，确保各项数据稳定高效传输。</p>\n      <div class=\"hero-links\">\n        <a href=\"#plans\">查看方案配置</a>\n        <a href=\"#guide\" class=\"outline\">使用说明</a>\n      </div>\n    </div>\n  </div>\n\n  <section class=\"band-alt\" id=\"plans\">\n    <div class=\"container\">\n      <h2>服务方案与定价</h2>\n      <p class=\"section-desc\">以下提供详细的套餐规格、流量配额及设备并发限制。所有方案均支持按月或按年订阅。</p>\n      \n      <div class=\"table-wrap\">\n        <table class=\"comparison\">\n          <thead>\n            <tr>\n              <th>方案名称</th>\n              <th>月付价格</th>\n              <th>年付优惠</th>\n              <th>每月流量</th>\n              <th>设备并发</th>\n              <th>核心权益</th>\n            </tr>\n          </thead>\n          <tbody>\n            <tr>\n              <td><strong>基础版</strong></td>\n              <td>¥15/月</td>\n              <td>¥150/年</td>\n              <td>100GB</td>\n              <td>3 台</td>\n              <td>基础流媒体解锁、普通线路节点</td>\n            </tr>\n            <tr>\n              <td><strong>旗舰版</strong></td>\n              <td>¥35/月</td>\n              <td>¥350/年</td>\n              <td>300GB</td>\n              <td>5 台</td>\n              <td>原生流媒体解锁、游戏加速优化、7x24 工单</td>\n            </tr>\n            <tr>\n              <td><strong>团队版</strong></td>\n              <td>¥85/月</td>\n              <td>¥850/年</td>\n              <td>1000GB</td>\n              <td>20 台</td>\n              <td>VIP 高带宽节点、企业定制路由、专属经理</td>\n            </tr>\n          </tbody>\n        </table>\n      </div>\n\n      <div class=\"grid-2\">\n        <div class=\"ticket-card\">\n          <h3>基础版</h3>\n          <div class=\"price\">¥15 / 月</div>\n          <ul>\n            <li>每月 100GB 基础流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体内容</li>\n            <li>普通线路节点池接入</li>\n          </ul>\n          <a href=\"#\" class=\"btn\">选择基础版</a>\n        </div>\n        <div class=\"ticket-card\">\n          <h3>旗舰版 (推荐)</h3>\n          <div class=\"price\">¥35 / 月</div>\n          <ul>\n            <li>每月 300GB 高速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>专属优化与优先支持</li>\n          </ul>\n          <a href=\"#\" class=\"btn\">选择旗舰版</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band-alt\" id=\"guide\">\n    <div class=\"container\">\n      <h2>使用说明与接入流程</h2>\n      <p class=\"section-desc\">按照以下步骤完成账户开通、客户端配置与连接测试。</p>\n      \n      <div class=\"steps-list\">\n        <div class=\"step-item\">\n          <div class=\"step-num\">01</div>\n          <div>\n            <h3>选择并开通方案</h3>\n            <p>根据您的实际流量与设备需求，挑选适合的订阅方案并完成开通流程。</p>\n          </div>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">02</div>\n          <div>\n            <h3>获取订阅凭证</h3>\n            <p>登录管理后台，复制专属的订阅链接或导入配置文件至您的客户端软件。</p>\n          </div>\n        </div>\n        <div class=\"step-item\">\n          <div class=\"step-num\">03</div>\n          <div>\n            <h3>连接网络节点</h3>\n            <p>在客户端中更新订阅并选择对应节点，一键启动连接即可开始使用。</p>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"band-alt\" id=\"faq\">\n    <div class=\"container\">\n      <h2>常见问题解答</h2>\n      <p class=\"section-desc\">关于账户、流量结算与连接配置的常见疑问。</p>\n      \n      <div class=\"faq-grid\">\n        <div class=\"faq-item\">\n          <h3>如何修改或升级我的当前方案？</h3>\n          <p>您可以在用户后台随时申请方案变更，系统将根据剩余有效天数自动折算差价进行升级。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>流量额度是每月自动重置吗？</h3>\n          <p>是的，所有套餐的流量均在每个计费周期的对应日自动重置，当月未使用完的流量不累计到下一周期。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>支持哪些主流客户端软件？</h3>\n          <p>skkm33 兼容当前各类主流传输协议客户端，支持 Windows、macOS、iOS、Android 等多平台。</p>\n        </div>\n        <div class=\"faq-item\">\n          <h3>遇到连接不稳定时如何排查？</h3>\n          <p>请先尝试更新订阅链接获取最新节点列表。如问题持续，可通过工单系统联系技术支持获取帮助。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n<footer>\n  <div class=\"container\">\n    <p>© skkm33. All rights reserved. 现代化网络传输与连接管理服务。</p>\n  </div>\n</footer>",
